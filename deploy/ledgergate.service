[Unit]
Description=LedgerGate account monitor and LLM gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/code/LedgerGate
ExecStart=/root/code/LedgerGate/bin/ledgergate
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ledgergate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/code/LedgerGate/data

[Install]
WantedBy=multi-user.target
