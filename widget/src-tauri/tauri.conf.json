{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LedgerGate Widget",
  "version": "../../web/package.json",
  "identifier": "com.ledgergate.widget",
  "mainBinaryName": "LedgerGateWidget",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "LedgerGate", "width": 400, "height": 720, "minWidth": 360, "minHeight": 360, "maxWidth": 720, "maxHeight": 900, "resizable": true, "center": true, "decorations": false, "alwaysOnTop": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser" } }
  }
}
